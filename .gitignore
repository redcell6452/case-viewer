# Default deny: only reviewed source, documentation and synthetic tests belong here.
# Real case files, extracted exports, screenshots and vendor software stay local.
*
!/.gitignore
!/case-viewer.html
!/README.md
!/FORMAT.md
!/METHODOLOGY.md
!/LICENSE
!/tests/
/tests/*
!/tests/regression.cjs
!/tests/browser.cjs
!/tools/
/tools/*
!/tools/make-test-case.cjs
!/test-cases/
/test-cases/*
!/test-cases/*.expected.md
